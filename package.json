{
  "name": "checklists-dudu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "dev:emulador": "vite --mode emulador",
    "emuladores": "firebase emulators:start --project demo-checklists",
    "test:emulador": "firebase emulators:exec --only auth,firestore --project demo-checklists \"vitest run --config vitest.emulador.config.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  }
}
